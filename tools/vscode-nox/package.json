{
  "name": "vscode-nox",
  "displayName": "Nox Mod Tools",
  "description": "Outils de développement pour mods Nox : validation relations, diagnostics GetMod, quick fixes.",
  "version": "0.1.0",
  "publisher": "nox",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/nox.mod.json",
    "workspaceContains:**/nox.mod.jsonc"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nox-mod.addRelation",
        "title": "Nox: Ajouter une relation dans nox.mod.json"
      },
      {
        "command": "nox-mod.rebuildIndex",
        "title": "Nox: Reconstruire l'index des mods"
      },
      {
        "command": "nox-mod.showLog",
        "title": "Nox: Afficher le log"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "nox.mod.json",
          "nox.mod.jsonc"
        ],
        "url": "./schemas/nox.mod.schema.json"
      }
    ],
    "languages": [
      {
        "id": "jsonc",
        "filenames": [
          "nox.mod.jsonc"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AtelierVR/runtime"
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run compile -- --watch",
    "typecheck": "tsc -p . --noEmit",
    "package": "npm run compile && vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.0.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
