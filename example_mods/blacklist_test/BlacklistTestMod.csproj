<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>BlacklistTestMod</AssemblyName>
    <RootNamespace>BlacklistTestMod</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unity Engine References -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\Build\NoxVR_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- Nox CCK Reference -->
    <Reference Include="Nox.CCK">
      <HintPath>..\..\Library\ScriptAssemblies\Nox.CCK.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- UniTask Reference -->
    <Reference Include="UniTask">
      <HintPath>..\..\Library\ScriptAssemblies\UniTask.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
