<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MaliciousMod</AssemblyName>
    <RootNamespace>MaliciousMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <OutputPath>build\malicious_test</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference Nox.CCK for mod interface -->
    <Reference Include="Nox.CCK">
      <HintPath>..\..\Library\ScriptAssemblies\Nox.CCK.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- Reference UnityEngine for Debug logging -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\Library\Bee\artifacts\WinPlayerBuildProgram\ManagedStripped\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
