{
    "omnisharp.enableRoslynAnalyzers": true,
    "omnisharp.useModernNet": true,
    "omnisharp.enableEditorConfigSupport": true,
    "dotnet.server.useOmnisharp": true,
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.vs": true,
        "**/.vsconfig": true,
        "**/*.booproj": true,
        "**/*.pidb": true,
        "**/*.suo": true,
        "**/*.user": false,
        "**/*.userprefs": true,
        "**/*.unityproj": true,
        "**/*.dll": false,
        "**/*.exe": false,
        "**/*.pdf": true,
        "**/*.mid": true,
        "**/*.midi": false,
        "**/*.wav": false,
        "**/*.gif": false,
        "**/*.ico": false,
        "**/*.jpg": false,
        "**/*.jpeg": false,
        "**/*.png": false,
        "**/*.psd": false,
        "**/*.tga": true,
        "**/*.tif": true,
        "**/*.tiff": true,
        "**/*.3ds": true,
        "**/*.3DS": true,
        "**/*.fbx": false,
        "**/*.FBX": true,
        "**/*.lxo": true,
        "**/*.LXO": true,
        "**/*.ma": true,
        "**/*.MA": true,
        "**/*.obj": true,
        "**/*.OBJ": true,
        "**/*.asset": false,
        "**/*.cubemap": true,
        "**/*.flare": true,
        "**/*.mat": false,
        "**/*.meta": true,
        "**/*.prefab": false,
        "**/*.unity": false,
        "build/": false,
        "Build/": false,
        "Library/": true,
        "library/": true,
        "obj/": true,
        "Obj/": true,
        "Logs/": true,
        "logs/": true,
        "ProjectSettings/": true,
        "UserSettings/": true,
        "temp/": true,
        "Temp/": true
    },
    "files.associations": {
        "*.asset": "yaml",
        "*.meta": "yaml",
        "*.prefab": "yaml",
        "*.unity": "yaml"
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.sln": "*.csproj"
    },
    "dotnet.defaultSolution": "runtime.slnx",
    "dotnet.preferCSharpExtension": true,
    "git.repositoryScanMaxDepth": 2,
    "git.openRepositoryInParentFolders": "always",
    "cmake.ignoreCMakeListsMissing": true
}