{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Sessions Panel",
			"type": "shell",
			"command": "echo",
			"args": [
				"Building Sessions Panel module..."
			],
			"group": "build",
			"isBackground": false
		},
		{
			"label": "Align C# declarations (=)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/StyleExample/Align-CSharpDeclarations.ps1",
				"-Path",
				"${file}",
				"-Names"
			],
			"problemMatcher": []
		}
	]
}