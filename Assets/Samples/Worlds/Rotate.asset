  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0f91c0f8758f952409d3853a82a0ddef, type: 3}
  m_Name: Rotate
  m_EditorClassIdentifier: Nox.CCK.YantraJS::Nox.CCK.YantraJS.YantraFile
  text: "// import { transform } from 'behaviour';\r\n\r\nlet d = Date.now();\r\nexport
    let speed = 0.1;\r\n\r\nexport function onUpdate() {\r\n    let delta = Date.now()
    - d;\r\n    d = Date.now();\r\n    transform.Rotate(delta * -speed, delta * speed,
    delta * -speed);\r\n}"
