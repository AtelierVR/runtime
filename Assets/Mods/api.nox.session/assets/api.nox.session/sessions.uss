/* Sessions Panel Styles */
.sessions-container {
    flex-grow: 1;
    padding: 12px;
    background-color: #2d2d30;
}

.sessions-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #464647;
}

.sessions-title {
    font-size: 18px;
    color: #f1f1f1;
    font-style: bold;
}

.sessions-header-actions {
    flex-direction: row;
}

.sessions-stats {
    margin-bottom: 16px;
    padding: 8px;
    background-color: #383838;
    border-radius: 4px;
}

.sessions-stat {
    color: #cccccc;
    margin-bottom: 4px;
    font-size: 12px;
}

.sessions-notifications {
    margin-bottom: 16px;
}

.sessions-scroll {
    flex-grow: 1;
}

.sessions-list {
    flex-grow: 1;
}

/* Session Item Styles */
.session-item {
    background-color: #3c3c3c;
    border-radius: 6px;
    margin-bottom: 8px;
    padding: 12px;
    border-width: 1px;
    border-color: #555555;
}

.session-item:hover {
    background-color: #404040;
}

.session-current {
    border-color: #007acc;
    background-color: #1e3a5f;
}

.session-current:hover {
    background-color: #234567;
}

.session-header {
    margin-bottom: 8px;
}

.session-title {
    font-size: 14px;
    font-style: bold;
    color: #ffffff;
}

.session-info {
    margin-bottom: 12px;
}

.session-adapter {
    color: #d4d4d4;
    font-size: 11px;
    margin-bottom: 4px;
}

.session-players {
    color: #c4c4c4;
    font-size: 11px;
    margin-bottom: 4px;
}

.session-world {
    color: #b4b4b4;
    font-size: 11px;
}

.session-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.session-action-button {
    margin-left: 8px;
    padding: 4px 12px;
    font-size: 11px;
    min-height: 24px;
}

.session-dispose-button {
    background-color: #c42b1c;
    border-color: #c42b1c;
    color: #ffffff;
}

.session-dispose-button:hover {
    background-color: #a23328;
    border-color: #a23328;
}

/* General Button Styles */
.sessions-button {
    padding: 6px 12px;
    font-size: 12px;
    min-height: 28px;
    background-color: #0e639c;
    border-color: #0e639c;
    color: #ffffff;
    border-radius: 4px;
}

.sessions-button:hover {
    background-color: #1177bb;
    border-color: #1177bb;
}

.sessions-dispose-all-button {
    background-color: #c42b1c;
    border-color: #c42b1c;
}

.sessions-dispose-all-button:hover {
    background-color: #a23328;
    border-color: #a23328;
}

.sessions-dispose-all-button:disabled {
    background-color: #666666;
    border-color: #666666;
    color: #999999;
}

/* No Sessions Message */
.session-no-sessions {
    text-align: center;
    color: #888888;
    font-style: italic;
    margin: 32px 0;
}
