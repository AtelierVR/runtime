<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/Mods/api.nox.world/assets/Style.uss?fileID=7433441132597879392&amp;guid=e5801f130c21d4a43937749c0d48a9cd&amp;type=3#Style" />
    <engine:VisualElement style="flex-grow: 1; padding-top: 4px; padding-bottom: 4px;">
        <engine:GroupBox style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;">
            <engine:VisualElement style="flex-grow: 1; border-left-color: rgb(47, 47, 47); border-right-color: rgb(47, 47, 47); border-top-color: rgb(47, 47, 47); border-bottom-color: rgb(47, 47, 47); border-bottom-width: 1px; padding-bottom: 4px; padding-top: 4px; flex-direction: row; padding-right: 8px; padding-left: 8px;">
                <engine:Label text="Performance Monitor" style="margin-right: 3px; margin-left: 3px; flex-grow: 1;" />
                <engine:Label text="v0.0.0" name="version" />
            </engine:VisualElement>
        </engine:GroupBox>
        <engine:ScrollView style="flex-grow: 1;">
            <engine:VisualElement style="flex-grow: 1;">
                <engine:VisualElement style="margin: 5px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;">
                    <engine:Label text="FPS: --" name="fps-label" />
                    <engine:Label text="Memory: --" name="memory-label" />
                    <engine:Label text="Draw Calls: --" name="draw-calls-label" />
                </engine:VisualElement>
                <engine:Foldout text="Performance Graph" name="perf-graph-foldout" style="background-color: rgb(42, 42, 42); border-radius: 4px; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; margin-top: 8px;">
                    <engine:VisualElement name="perf-graphic" style="height: 200px; margin: 5px; flex-grow: 1;" />
                </engine:Foldout>
                <engine:Foldout text="Mods" name="mods-foldout" style="background-color: rgb(42, 42, 42); border-radius: 4px; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; margin-top: 8px;">
                    <engine:VisualElement name="mods" style="flex-grow: 1; padding-top: 0; padding-right: 8px; padding-bottom: 8px; padding-left: 8px;" />
                </engine:Foldout>
            </engine:VisualElement>
        </engine:ScrollView>
    </engine:VisualElement>
</engine:UXML>
