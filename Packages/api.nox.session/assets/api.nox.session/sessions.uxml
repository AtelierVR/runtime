<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/Mods/api.nox.session/assets/api.nox.session/sessions.uss?fileID=7433441132597879392&amp;guid=ef6c4b8a8e8944c4bb02d8c5b6b2b8f6&amp;type=3#sessions" />
    <ui:VisualElement name="sessions-panel" class="sessions-container">
        <ui:VisualElement name="header" class="sessions-header">
            <ui:Label text="Sessions Manager" display-tooltip-when-elided="true" name="title" class="sessions-title" />
            <ui:VisualElement name="header-actions" class="sessions-header-actions">
                <ui:Button text="Dispose All" display-tooltip-when-elided="true" name="dispose-all-button" class="sessions-button sessions-dispose-all-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="stats" class="sessions-stats">
            <ui:Label text="Sessions: 0" display-tooltip-when-elided="true" name="sessions-count" class="sessions-stat" />
            <ui:Label text="No current session" display-tooltip-when-elided="true" name="current-session" class="sessions-stat" />
        </ui:VisualElement>
        <ui:VisualElement name="notifications" class="sessions-notifications" />
        <ui:ScrollView scroll-deceleration-rate="0.135" elasticity="0.1" name="sessions-scroll" class="sessions-scroll">
            <ui:VisualElement name="sessions-list" class="sessions-list" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
